---
import Button from '../ui/Button.astro';
import { temoignages } from '../../data/contenu';
import { liens } from '../../data/site';
---
<section class="section paroles" id="paroles" aria-labelledby="paroles-titre">
  <div class="container">
    <header class="head">
      <p class="eyebrow reveal">Paroles de gazelles</p>
      <h2 id="paroles-titre" class="reveal" style="--d:.06s">Elles l’ont fait.<br /><span>Elles racontent.</span></h2>
    </header>

    <ul class="liste" role="list">
      {temoignages.map((t, i) => (
        <li class="citation reveal" style={`--d:${0.1 * i}s`}>
          <svg class="guil" viewBox="0 0 48 36" width="46" height="34" aria-hidden="true"><path d="M0 36V22C0 9 8 1 21 0v8c-6 1-9 5-9 10h9v18zm27 0V22c0-13 8-21 21-22v8c-6 1-9 5-9 10h9v18z" fill="currentColor" /></svg>
          <blockquote>
            <p>{t.texte}</p>
          </blockquote>
          <footer>
            <strong>{t.auteur}</strong>
            <span>{t.edition}</span>
          </footer>
        </li>
      ))}
    </ul>

    <div class="actions reveal">
      <Button href={liens.temoignages} official variant="light">Lire leurs messages</Button>
    </div>
  </div>
</section>

<style>
  .paroles { background: radial-gradient(120% 90% at 85% 0%, var(--violet-700) 0%, var(--violet-900) 45%, var(--violet-950) 100%); color: var(--white); overflow: hidden; }
  .eyebrow { font-size: 0.85rem; font-weight: 700; letter-spacing: 0.16em; text-transform: uppercase; color: var(--rose-500); display: inline-flex; align-items: center; gap: 0.8rem; }
  .eyebrow::before { content: ''; width: 36px; height: 3px; background: var(--coral-500); border-radius: 3px; }
  h2 { margin-top: 1rem; font-size: clamp(2.2rem, 5.2vw, 4.4rem); text-transform: uppercase; letter-spacing: -0.025em; }
  h2 span { color: var(--coral-500); }
  .liste { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1.3rem; margin-top: clamp(2.2rem, 5vw, 3.6rem); }
  .citation { position: relative; display: flex; flex-direction: column; padding: 2rem 1.8rem 1.7rem; border-radius: var(--radius-l); background: rgba(255, 255, 255, 0.07); border: 1px solid rgba(255, 255, 255, 0.16); backdrop-filter: blur(8px); transition: transform 0.45s var(--ease), background-color 0.45s, border-color 0.45s; }
  .citation:hover { transform: translateY(-6px); background: rgba(255, 255, 255, 0.12); border-color: var(--coral-500); }
  .guil { color: var(--coral-500); margin-bottom: 1.2rem; }
  blockquote { margin: 0; flex: 1; }
  blockquote p { font-size: 1.08rem; line-height: 1.65; color: rgba(255, 255, 255, 0.96); }
  footer { margin-top: 1.5rem; padding-top: 1.1rem; border-top: 1px solid rgba(255, 255, 255, 0.2); display: grid; gap: 0.15rem; }
  footer strong { font-size: 0.98rem; }
  footer span { font-size: 0.82rem; color: var(--rose-500); letter-spacing: 0.04em; }
  .actions { margin-top: 2.4rem; }
  @media (max-width: 980px) { .liste { grid-template-columns: 1fr; } }
</style>
