---
import { Image } from 'astro:assets';
import sable from '../../assets/photos/sable-projete.webp';
import montee from '../../assets/photos/montee-dune.webp';
import contrejour from '../../assets/photos/contre-jour-dunes.webp';
import effort from '../../assets/photos/effort-poussiere.webp';
import desens from '../../assets/photos/desensablement.webp';
import arche from '../../assets/photos/arrivee-arche.jpg';
import dons from '../../assets/photos/dons-caravane.jpg';
import equipe from '../../assets/photos/equipe-casques.webp';
import flotte from '../../assets/photos/flotte-plage.webp';
import { alt } from '../../data/contenu';

const photos = [
  { src: sable, alt: alt.sable, cls: 'a', legende: 'Dunes' },
  { src: desens, alt: alt.desensablement, cls: 'b', legende: 'Désensablement' },
  { src: effort, alt: alt.effort, cls: 'c', legende: 'Effort' },
  { src: contrejour, alt: alt.contrejour, cls: 'd', legende: 'Contre-jour' },
  { src: montee, alt: alt.montee, cls: 'e', legende: 'Montée de dune' },
  { src: dons, alt: alt.dons, cls: 'f', legende: 'Solidarité' },
  { src: equipe, alt: alt.equipe, cls: 'h', legende: 'Esprit d’équipe' },
  { src: arche, alt: alt.arche, cls: 'g', legende: 'Ligne d’arrivée' },
  { src: flotte, alt: alt.flotte, cls: 'i', legende: 'Colonne de véhicules' },
];
---
<section class="section galerie" id="galerie" aria-labelledby="galerie-titre">
  <div class="container">
    <header class="head">
      <p class="eyebrow reveal">Galerie</p>
      <h2 id="galerie-titre" class="reveal" style="--d:.06s">Le désert,<br />étape par <span>étape.</span></h2>
    </header>
    <ul class="mosaique" role="list">
      {photos.map((p, i) => (
        <li class={`ph ${p.cls} reveal`} style={`--d:${0.06 * i}s`}>
          <Image src={p.src} alt={p.alt} widths={[400, 700, 1000]} sizes="(min-width: 960px) 30vw, 92vw" loading="lazy" />
          <span class="leg">{p.legende}</span>
        </li>
      ))}
    </ul>
    <p class="credit">Photographies officielles du Rallye (provisoires, tirées du site actuel).</p>
  </div>
</section>

<style>
  .galerie { background: var(--violet-50); }
  .eyebrow { font-size: 0.85rem; font-weight: 700; letter-spacing: 0.16em; text-transform: uppercase; color: var(--violet-700); display: inline-flex; align-items: center; gap: 0.8rem; }
  .eyebrow::before { content: ''; width: 36px; height: 3px; background: var(--coral-500); border-radius: 3px; }
  h2 { margin-top: 1rem; font-size: clamp(2.2rem, 5.2vw, 4.4rem); text-transform: uppercase; color: var(--violet-900); letter-spacing: -0.025em; }
  h2 span { color: var(--coral-700); }
  .mosaique { display: grid; grid-auto-flow: dense; grid-template-columns: repeat(4, 1fr); grid-auto-rows: clamp(150px, 17vw, 230px); gap: 0.9rem; margin-top: clamp(2.2rem, 5vw, 3.4rem); }
  .ph { position: relative; overflow: hidden; border-radius: var(--radius-m); box-shadow: var(--shadow-s); isolation: isolate; }
  .ph :global(img) { width: 100%; height: 100%; object-fit: cover; transition: transform 1.1s var(--ease); }
  .ph:hover :global(img) { transform: scale(1.08); }
  .ph::after { content: ''; position: absolute; inset: 0; background: linear-gradient(0deg, rgba(23, 10, 41, 0.7), transparent 45%); opacity: 0; transition: opacity 0.4s; }
  .ph:hover::after { opacity: 1; }
  .leg { position: absolute; left: 1rem; bottom: 0.9rem; z-index: 2; color: var(--white); font-weight: 600; font-size: 0.92rem; opacity: 0; transform: translateY(8px); transition: opacity 0.4s, transform 0.4s var(--ease); }
  .ph:hover .leg { opacity: 1; transform: none; }
  .a { grid-column: span 2; grid-row: span 2; }
  .b { grid-row: span 2; }
  .c { grid-column: span 1; }
  .d { grid-column: span 1; }
  .e { grid-column: span 2; }
  .f { grid-column: span 1; grid-row: span 2; }
  .g { grid-column: span 2; }
  .h { grid-column: span 1; }
  .i { grid-column: span 1; }
  .a :global(img) { object-position: 55% 55%; }
  .b :global(img) { object-position: 50% 30%; }
  .credit { margin-top: 1.4rem; font-size: 0.8rem; color: var(--ink-soft); }
  @media (max-width: 860px) {
    .mosaique { grid-template-columns: repeat(2, 1fr); grid-auto-rows: 180px; }
    .a { grid-column: span 2; grid-row: span 2; }
    .b { grid-row: span 2; } .e, .g { grid-column: span 2; } .f { grid-row: span 1; }
    .h, .i { grid-column: span 1; }
  }
  .ph .leg { pointer-events: none; }
  @media (hover: none) { .leg { opacity: 1; transform: none; } .ph::after { opacity: 1; } }
</style>
