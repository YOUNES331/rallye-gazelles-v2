---
import { Image } from 'astro:assets';
import dunes from '../../assets/photos/dunes-panorama.jpg';
import { chiffres } from '../../data/contenu';
---
<section class="chiffres" id="chiffres" aria-labelledby="chiffres-titre">
  <div class="bg" aria-hidden="true"><Image src={dunes} alt="" widths={[960, 1920]} sizes="100vw" loading="lazy" /></div>
  <div class="container">
    <h2 id="chiffres-titre" class="sr-only">Le Rallye en chiffres</h2>
    <p class="eyebrow reveal">Le Rallye en chiffres</p>
    <ul class="grille" role="list">
      {chiffres.map((c, i) => (
        <li class="reveal" style={`--d:${0.1 * i}s`}>
          <p class="valeur"><span data-count={c.valeur}>{c.valeur}</span>{c.suffixe}{c.unite && <small>{c.unite}</small>}</p>
          <p class="label">{c.label}</p>
        </li>
      ))}
    </ul>
    <p class="source">Sources : site officiel du Rallye, dossier de presse 2024 et communiqués de départ 2026.</p>
  </div>
</section>

<style>
  .chiffres { position: relative; isolation: isolate; padding-block: clamp(4rem, 8vw, 7rem); color: var(--white); background: var(--violet-950); overflow: hidden; }
  .bg { position: absolute; inset: 0; z-index: -2; }
  .bg :global(img) { width: 100%; height: 100%; object-fit: cover; opacity: 0.55; }
  .chiffres::before { content: ''; position: absolute; inset: 0; z-index: -1; background: linear-gradient(180deg, rgba(23, 10, 41, 0.92), rgba(43, 18, 71, 0.82)); }
  .eyebrow { font-size: 0.85rem; font-weight: 700; letter-spacing: 0.16em; text-transform: uppercase; color: var(--rose-500); display: inline-flex; align-items: center; gap: 0.8rem; }
  .eyebrow::before { content: ''; width: 36px; height: 3px; background: var(--coral-500); border-radius: 3px; }
  .grille { display: grid; grid-template-columns: repeat(4, 1fr); gap: 1.4rem; margin-top: 2.2rem; }
  .grille li { padding: 1.6rem 0 0; border-top: 2px solid rgba(255, 255, 255, 0.25); }
  .valeur { font-family: var(--font-title); font-weight: 800; font-size: clamp(3.2rem, 6.6vw, 6rem); line-height: 1; letter-spacing: -0.03em; background: linear-gradient(120deg, var(--coral-500), var(--rose-500)); -webkit-background-clip: text; background-clip: text; color: transparent; }
  .valeur small { font-size: 0.34em; font-weight: 700; letter-spacing: 0; margin-left: 0.3em; text-transform: uppercase; white-space: nowrap; -webkit-text-fill-color: var(--rose-500); }
  .label { margin-top: 0.8rem; max-width: 16rem; font-size: 1rem; color: rgba(255, 255, 255, 0.9); }
  .source { margin-top: 2.6rem; font-size: 0.8rem; opacity: 0.6; }
  @media (max-width: 900px) { .grille { grid-template-columns: repeat(2, 1fr); gap: 2.2rem 1.2rem; } }
  @media (max-width: 460px) { .grille { grid-template-columns: 1fr; } }
</style>
