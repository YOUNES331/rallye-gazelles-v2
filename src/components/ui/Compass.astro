---
// Boussole décorative : symbolise la navigation et la précision. L'aiguille suit le défilement.
interface Props { class?: string }
const { class: extra = '' } = Astro.props;
---
<svg class={`compass ${extra}`} viewBox="0 0 200 200" aria-hidden="true" focusable="false" data-compass>
  <circle cx="100" cy="100" r="94" fill="none" stroke="currentColor" stroke-opacity=".35" stroke-width="1.5" />
  <circle cx="100" cy="100" r="78" fill="none" stroke="currentColor" stroke-opacity=".2" stroke-width="1" stroke-dasharray="2 5" />
  {Array.from({ length: 36 }).map((_, i) => (
    <line x1="100" y1="8" x2="100" y2={i % 9 === 0 ? 24 : 15} stroke="currentColor" stroke-opacity={i % 9 === 0 ? 0.9 : 0.4} stroke-width={i % 9 === 0 ? 2.2 : 1.2} transform={`rotate(${i * 10} 100 100)`} />
  ))}
  <text x="100" y="46" text-anchor="middle" font-size="15" font-weight="700" fill="currentColor" font-family="Poppins, sans-serif">N</text>
  <g class="needle" data-needle>
    <polygon points="100,38 108,100 100,92 92,100" fill="var(--coral-500)" />
    <polygon points="100,162 92,100 100,108 108,100" fill="currentColor" fill-opacity=".85" />
    <circle cx="100" cy="100" r="6" fill="var(--violet-950)" stroke="currentColor" stroke-width="2" />
  </g>
</svg>

<style>
  .compass { width: 100%; height: auto; color: var(--white); }
  .needle { transform-origin: 100px 100px; transform: rotate(var(--needle, 20deg)); transition: transform 0.9s var(--ease); }
</style>
