---
import { site } from '../../data/site';
---
<dialog class="video-dialog" id="video-dialog" aria-label="Vidéo officielle du Rallye" data-video-src={site.video}>
  <div class="frame">
    <button class="close" type="button" data-video-close aria-label="Fermer la vidéo">
      <svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true"><path d="M5 5l14 14M19 5L5 19" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" /></svg>
    </button>
    <video controls playsinline preload="none"></video>
    <p>Vidéo officielle du Rallye, hébergée sur le site actuel. Elle ne se charge qu’à l’ouverture.</p>
  </div>
</dialog>

<style>
  .video-dialog { border: 0; padding: 0; background: transparent; width: min(1100px, 94vw); max-height: 92vh; color: var(--white); overflow: visible; }
  .video-dialog::backdrop { background: rgba(10, 4, 20, 0.88); backdrop-filter: blur(6px); }
  .frame { position: relative; }
  video { width: 100%; max-height: 78vh; background: #000; border-radius: var(--radius-m); box-shadow: var(--shadow-m); }
  .close { position: absolute; right: 0; top: -54px; width: 46px; height: 46px; border-radius: 50%; border: 1.5px solid rgba(255, 255, 255, 0.6); background: rgba(255, 255, 255, 0.1); color: var(--white); display: grid; place-items: center; }
  .close:hover { background: var(--white); color: var(--violet-900); }
  p { margin-top: 0.8rem; font-size: 0.85rem; opacity: 0.75; text-align: center; }
</style>
